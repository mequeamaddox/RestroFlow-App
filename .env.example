# ─────────────────────────────────────────────
# RestroFlow — Required Environment Variables
# Copy this file to .env and fill in values.
# ─────────────────────────────────────────────

# ── App ──────────────────────────────────────
NODE_ENV=production
PORT=5000
# Public URL of your deployed app (used in emails, webhooks, etc.)
APP_URL=https://your-railway-domain.up.railway.app
# Long random string — generate with: openssl rand -hex 32
SESSION_SECRET=

# ── Database ─────────────────────────────────
# Neon serverless PostgreSQL connection string — use either name
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# NEON_DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ── Authentication (Clerk) ───────────────────
# Frontend (baked into the JS bundle at build time by Vite):
VITE_CLERK_PUBLISHABLE_KEY=pk_live_...
# Backend only — NEVER use a VITE_ prefix for the secret key:
CLERK_SECRET_KEY=sk_live_...

# ── Email (Resend) ───────────────────────────
RESEND_API_KEY=re_...
# Sender address — must be from a domain verified in Resend
FROM_EMAIL=noreply@restroflow.com

# ── Payments (Stripe) ────────────────────────
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Price IDs from your Stripe dashboard
STRIPE_PRICE_PROFESSIONAL=price_...
STRIPE_PRICE_ENTERPRISE=price_...

# ── POS — SpotOn (polling tunables) ──────────
# Defaults used if not set:
# SPOTON_POLL_INTERVAL_MINUTES=1
# SPOTON_LAG_MINUTES=2
# SPOTON_BACKFILL_HOURS=26

# ── AWS Textract (optional — OCR fallback) ───
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# ── Replit Object Storage (Replit-only) ──────
# Leave blank when deploying outside Replit.
# PUBLIC_OBJECT_SEARCH_PATHS=
# PRIVATE_OBJECT_DIR=
