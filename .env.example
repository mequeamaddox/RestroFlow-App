# ─────────────────────────────────────────────
# RestroFlow — Required Environment Variables
# Copy this file to .env and fill in values.
# ─────────────────────────────────────────────

# ── App ──────────────────────────────────────
NODE_ENV=production
PORT=5000
# Public URL of your deployed app (used in emails, webhooks, etc.)
APP_URL=https://your-railway-domain.up.railway.app

# ── Database ─────────────────────────────────
# Neon serverless PostgreSQL connection string
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ── Authentication (Clerk) ───────────────────
VITE_CLERK_PUBLISHABLE_KEY=pk_live_...
VITE_CLERK_SECRET_KEY=sk_live_...

# ── Email (SendGrid) ─────────────────────────
SENDGRID_API_KEY=SG....
# Sender address verified in SendGrid
FROM_EMAIL=noreply@restroflow.com

# ── Payments (Stripe) ────────────────────────
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Price IDs from your Stripe dashboard
STRIPE_PRICE_PROFESSIONAL=price_...
STRIPE_PRICE_ENTERPRISE=price_...

# ── POS — Square ─────────────────────────────
SQUARE_ACCESS_TOKEN=
SQUARE_APPLICATION_ID=
SQUARE_ENVIRONMENT=production
SQUARE_WEBHOOK_SIGNATURE_KEY=

# ── POS — SpotOn (polling tunables) ──────────
# Defaults used if not set:
# SPOTON_POLL_INTERVAL_MINUTES=1
# SPOTON_LAG_MINUTES=2
# SPOTON_BACKFILL_HOURS=26

# ── Firebase (optional — storage/notifications) ──
FIREBASE_SERVICE_ACCOUNT_JSON=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=

# ── AWS Textract (optional — OCR fallback) ───
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# ── Twilio (optional — SMS alerts) ───────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ── Replit Object Storage (Replit-only) ──────
# Leave blank when deploying outside Replit.
# PUBLIC_OBJECT_SEARCH_PATHS=
# PRIVATE_OBJECT_DIR=
